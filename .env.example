# =============================================================================
# MousaviTax AI Platform — Environment Variables (TEMPLATE)
# =============================================================================
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# All secrets MUST be set via your hosting provider (Vercel/Railway/etc).
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Next.js — public, exposed to browser)
# -----------------------------------------------------------------------------
# IMPORTANT: This must be the API URL, NOT the dashboard URL.
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://jdvlzgljfodltmzvdpld.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Backend API (FastAPI — server-side only, NEVER prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://jdvlzgljfodltmzvdpld.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000
API_SECRET_KEY=            # REQUIRED: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`

# -----------------------------------------------------------------------------
# Demo Mode (offline) — when true, returns sample tax laws instead of Drive
# Auto-activates if LOVABLE_API_KEY and GOOGLE_SERVICE_ACCOUNT_JSON are both unset.
# -----------------------------------------------------------------------------
SOURCE_BRIDGE_DEMO_MODE=false  # set 'true' to force-enable

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# -----------------------------------------------------------------------------
# LLM / AI Gateway
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama        # ollama | openai | gemini
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=ollama

# Alternative providers (uncomment to use):
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-lite

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB (choose one):
# Option 1: Legacy JSON-based (development only)
VECTOR_DB_PATH=data/iran_tax_vectors.json
# Option 2: Qdrant (recommended for production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Option 3: pgvector via Supabase (uses SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY)
VECTOR_DB_PROVIDER=qdrant  # json | qdrant | pgvector

# -----------------------------------------------------------------------------
# Domain
# -----------------------------------------------------------------------------
ACTIVE_DOMAIN=iran-tax

# -----------------------------------------------------------------------------
# Google Drive knowledge
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_IDS=
GOOGLE_DRIVE_PRIMARY_FOLDER=1Jx0cipUqQyGnJk4hFCURzWIg1Abo1Del
GOOGLE_DRIVE_FALLBACK_FOLDER=1NcBkZOTemmVfnNKY7FgxuqbIXj6f4Dtl

# Drive picker integration (used by /registry screen — migration 005)
# Required for "select from Drive" feature in the registration form.
# Get these from Lovable → Settings → Integrations → Google Drive.
LOVABLE_API_KEY=
GOOGLE_DRIVE_API_KEY=

# Master folder for TAXLAW-GROK Constitution modules (Principle 4)
# Default: official master folder shared in ADR-009
TAXLAW_GROK_MASTER_FOLDER_ID=1M7rsSpQf0akKKmV2P6o66A-uj8KF3cJW

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
SENTRY_DSN=                # Optional — set in production
OTEL_EXPORTER_OTLP_ENDPOINT=  # Optional — for OpenTelemetry

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_EMAIL=ziya.mka2026@gmail.com
WEB_PUBLIC_URL=http://localhost:3001
